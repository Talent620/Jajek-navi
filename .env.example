# Skopiuj do .env i uzupełnij własnym publicznym tokenem Mapbox.
# .env jest w .gitignore — NIE commituj prawdziwego klucza.
#
# Token uzyskasz na https://account.mapbox.com/access-tokens/
# Zalecane: ustaw URL/token restrictions dla tokena publicznego.
VITE_MAPBOX_TOKEN=pk.your_public_mapbox_token_here

# Opcjonalnie: styl mapy (domyślnie ciemny, driving-friendly)
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/navigation-night-v1
