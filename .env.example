# Wszystkie zmienne są OPCJONALNE — aplikacja działa bez nich (darmowe OSM).
# Skopiuj do .env tylko jeśli chcesz wskazać własne serwery / styl mapy.

# Własny serwer OSRM (trasy + optymalizacja). Domyślnie publiczny demo.
# VITE_OSRM_URL=https://router.project-osrm.org

# Własny serwer Nominatim (geokodowanie). Domyślnie publiczny OSM.
# VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Własny styl MapLibre (vector). Domyślnie wbudowany ciemny raster OSM/CARTO.
# VITE_MAP_STYLE=https://twoj-styl-maplibre.json

# Repo GitHub do sprawdzania aktualizacji APK (owner/repo).
# VITE_UPDATE_REPO=talent620/jajek-navi
